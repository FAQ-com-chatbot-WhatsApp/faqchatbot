{
	"name": "chatbot/platform",
	"description": "Plataforma de fluxos conversacionais sobre Joomla",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": "^8.1",
		"vlucas/phpdotenv": "^5.6",
		"firebase/php-jwt": "^6.10",
		"ramsey/uuid": "^4.7",
		"respect/validation": "^2.2"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"WhatsBot\\": "src/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"scripts": {
		"post-install-cmd": [
			"Composer\\Config::disableProcessTimeout",
			"@post-autoload-dump"
		],
		"post-update-cmd": [
			"Composer\\Config::disableProcessTimeout",
			"@post-autoload-dump"
		]
	}
}
