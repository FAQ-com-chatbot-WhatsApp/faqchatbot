<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
            name="search"
            type="text"
            hint="JSEARCH_FILTER"
        />

        <field
            name="state"
            type="status"
            label="JSTATUS"
            filter="*,-2,0,1"
            onchange="this.form.submit();"
            >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

		<field
			name="id_category"
			type="category"
			label="JOPTION_FILTER_CATEGORY"
			extension="com_nobossfaq"
			description="JOPTION_FILTER_CATEGORY_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>

		<field
			id="id_faqs_group"
		  	name="id_faqs_group"
		   	type="sql"
		   	label="COM_NOBOSSFAQ_OPTION_FILTER_GROUP"
		   	description="COM_NOBOSSFAQ_OPTION_FILTER_GROUP_DESC"
		   	query="
		    	SELECT
		    		*
		    	FROM
		    		#__noboss_faq_group"
		   	key_field="id_faqs_group"
		   	value_field="name_faqs_group"
		   	onchange="this.form.submit();">
    		<option value="">COM_NOBOSSFAQ_QUESTIONS_FILTER_GROUP</option>
		</field>

	</fields>
	<fields name="list">
		<field
            name="limit"
            type="limitbox"
            class="input-mini"
            default="25"
            label="COM_CONTENT_LIST_LIMIT"
            description="COM_CONTENT_LIST_LIMIT_DESC"
            onchange="this.form.submit();"
        />
	</fields>
</form>
