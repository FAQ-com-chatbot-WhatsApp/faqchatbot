<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="hidden" addfieldpath="libraries/noboss/forms/fields">	
        <field type="nobossloadtranslation" />
        <field type="nobosshaslibrary"/>
        <field type="nobossrequestjsconstants" constants="NOBOSS_EXTENSIONS_GLOBAL_NEW"/>
    </fieldset>
    <fieldset name="questions" addfieldpath="libraries/noboss/forms/fields" label="COM_NOBOSSFAQ_GROUP_TAB_QUESTIONS">	
		<field
			id="id_faqs_group"
		  	name="id_faqs_group"
		   	type="sql"
		   	default=""
		   	label="COM_NOBOSSFAQ_FAQS_GROUP_LABEL"
		   	description="COM_NOBOSSFAQ_FAQS_GROUP_DESC"
		   	query="
		    	SELECT
		    		*
		    	FROM
		    		#__noboss_faq_group
		    	WHERE
		    		state = 1"
		   	key_field="id_faqs_group"
		   	value_field="name_faqs_group"
		   	required="true"
               parentclass="stack span-3-inline"
    	>
		</field>
		<field
			name="id_category"
			type="sql"
			label="JCATEGORY"
			description="COM_NOBOSSFAQ_SUBJECT_SQL_DESC"
			query="SELECT id, title FROM #__categories WHERE extension = 'com_nobossfaq' AND published = 1"
			key_field= "id"
            required="true"
			value_field="title"
            parentclass="stack span-3-inline" />

		<field
			name="question"
			type="textarea"
            rows="2"
            class="span12"
            filter="safehtml"
			label="COM_NOBOSSFAQ_QUESTION"
			required="required"
			description="COM_NOBOSSFAQ_EDIT_QUESTION_DESC"
            parentclass="stack" />

		<field 
			name="answer" 
			type="nobosseditorfaq" 
			filter="JComponentHelper::filterText"
			required="required"
			height="300px"
			buttons="false"
			toolbar_show="bold,italic,underline,|,alignleft,aligncenter,alignright,alignjustify,|,bullist,numlist,outdent,indent,|,fontsizeselect,formatselect,|,forecolor,backcolor,|,table,codesample"
			label="COM_NOBOSSFAQ_ANSWER"
			description="COM_NOBOSSFAQ_EDIT_ANSWER_DESC"
            editor="tinymce"
            parentclass="stack"
			/>
	</fieldset>

    <fieldset name="filters_link" label="COM_NOBOSSFAQ_FILTER_LINK_TAB" description="COM_NOBOSSFAQ_FILTER_LINK_TAB_DESC">	
        <field 
			type="nobosslinkquestion" 
            parentclass="stack"
			/>
    </fieldset>

	<fieldset name="details">
		<field 
			name="state" 
			type="list"
			label="JSTATUS" 
			description="JFIELD_PUBLISHED_DESC"
			class="chzn-color-state form-select-color-state" 
			size="1" 
			default="1">
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<field
			id="created_by"
			name="created_by"
			type="user"
			class="text"
			label="JGLOBAL_FIELD_CREATED_BY_LABEL"
			description="JGLOBAL_FIELD_CREATED_BY_DESC"
			default=" "
			readonly="true" />

		<field
			id="created"
			name="created"
			type="text"
			class="text"
			label="JGLOBAL_FIELD_CREATED_LABEL"
			description="JGLOBAL_FIELD_CREATED_DESC"
			default=" "
			readonly="true" />
	
		<field
			id="modified_by"
			name="modified_by"
			type="user"
			class="text"
			label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
			description="JGLOBAL_FIELD_MODIFIED_BY_DESC"
			readonly="true" />
			
		<field
			id="modified"
			name="modified"
			type="text"
			class="text"
			label="JGLOBAL_FIELD_MODIFIED_LABEL"
			readonly="true" />
			
		<field
			id="id_faq"
			name="id_faq"
			type="text"
			default="0"
			readonly="true"
			class="readonly"
			label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" />

	</fieldset>

    <fieldset name="license" label="NOBOSS_EXTENSIONS_TAB_LICENSE_LABEL">
        <field
            type="nobosslicense"
            name="license"
            label="NOBOSS_EXTENSIONS_LICENSE_LABEL"
            description="NOBOSS_EXTENSIONS_LICENSE_DESC"
            default="2"
        />
    </fieldset>
</form>
